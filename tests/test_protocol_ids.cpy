def table_is_dense(state: int, direction: int, fails: int*) -> void:
    str[] names = pkt_names(state, direction)
    int64[] ids = pkt_table_ids(state, direction)
    check("names and ids are the same length", (int)len(names) == (int)len(ids), fails)
    int i = 0
    int dense = 1
    while i < (int)len(ids):
        if ids[i] != (int64)i:
            dense = 0
        i += 1
    check("ids are dense from zero", dense == 1, fails)
    i = 0
    int unique = 1
    while i < (int)len(names):
        int j = i + 1
        while j < (int)len(names):
            if str_equals(names[i], names[j]):
                unique = 0
            j += 1
        i += 1
    check("names are unique", unique == 1, fails)

